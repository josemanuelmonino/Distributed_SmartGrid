    {
        "id": "17723b54ceb329b2",
        "type": "function",
        "z": "55f0786cb5b520b6",
        "name": "Prepare dashboard data",
        "func": "const s = msg.payload;\nconst selected = flow.get(\"selected_home\") || \"h1\";\nconst tariff = global.get(\"current_tariff\") || { period: \"FLAT (0.15 €/kWh)\" };\nconst costs = global.get(\"costs\") || {};\nconst statuses = global.get(\"statuses\") || {};\n\n\n// 1. Comparative graph of grid consumption \nconst gridAllMsg = { topic: s.home.toUpperCase(), payload: s.grid_w };\n\n// 2. Simulated clock time and corresponding active tariff/prices\nconst clockMsg = { payload: `${s.sim_time} — ${tariff.period}` };\n\n// 3. Dynamic cumulative costs (€) for all homes\nconst homesMap = global.get(\"homes\") || {};\nconst homeIds = Object.keys(homesMap).sort();\nconst costStr = homeIds.map(id => `${id.toUpperCase()}: ${(costs[id] || 0).toFixed(2)} €`).join(\" | \");\nconst costMsg = { payload: costStr || \"Calculating...\" };\n\n// 4. Dynamic online/offline states for LWT\nconst statusStr = homeIds.map(id => `${id.toUpperCase()}: ${(statuses[id] || \"online\").toUpperCase()}`).join(\" | \");\nconst fleetMsg = { payload: statusStr || \"Waiting...\" };\n\n// 5-11. Widgets for the home selected in the dropdown\nif (s.home === selected) {\n    const solarMsg = { payload: s.generation_w }; //power generated by solar pannels\n    const consMsg = { payload: s.consumption_w };\n    const socMsg = { payload: s.battery_soc_pct !== null ? s.battery_soc_pct : 0 }; //current battery percentage (if applicable)\n    const batText = s.battery_soc_pct !== null ? s.battery_mode : \"none\";\n    const stateMsg = {\n        payload: `Battery: ${batText} | Shed: ${s.shed_loads.length ? s.shed_loads.join(\", \") : \"none\"}`\n    };\n    //curves to be shown in Home energy balance graph\n    const chartSolar = { topic: \"Solar (W)\", payload: s.generation_w };\n    const chartCons = { topic: \"Consumption (W)\", payload: s.consumption_w };\n    const chartGrid = { topic: \"Grid (W)\", payload: s.grid_w };\n\n    return [gridAllMsg, clockMsg, costMsg, fleetMsg, solarMsg, consMsg, socMsg, stateMsg, chartSolar, chartCons, chartGrid];\n}\n\nreturn [gridAllMsg, clockMsg, costMsg, fleetMsg, null, null, null, null, null, null, null];",
        "outputs": 11,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
