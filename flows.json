        "z": "55f0786cb5b520b6",
        "name": "Manual battery mode override",
        "func": "const h = flow.get(\"selected_home\") || \"h1\"; \n//gets stored manual override orders\nconst overrides = global.get(\"overrides\") || {};\nif (!overrides[h]) overrides[h] = {};\n\nif (msg.payload === \"\") { //if first option has been chosen (EMS automatic)\n    delete overrides[h].battery; //deletes manual override order (Smart EMS rules will take charge again)\n    global.set(\"overrides\", overrides); //not override mode anymore\n    return null;\n}\n\noverrides[h].battery = msg.payload; //if any other override option, write it down (Smart EMS rules not in charge)\nglobal.set(\"overrides\", overrides);\n//sends MQTT command to override battery mode\nreturn { topic: `microgrid/${h}/cmd/battery`, payload: { mode: msg.payload } };",
        "outputs": 1,
