        "func": "const data = msg.payload;\nif (!data || !data.home || !data.device) return null;\n\n//we save each house's devices\nconst inventory = global.get(\"inventory\") || {};\nif (!inventory[data.home]) inventory[data.home] = {};\ninventory[data.home][data.device] = true;\nglobal.set(\"inventory\", inventory);\n\nreturn null;",
