    {
        "id": "6c053c66c0abfc7a",
        "type": "function",
        "z": "770909d5736a146f",
        "name": "Smart EMS rules",
        "func": "const s = msg.payload;\nconst h = s.home;\nconst hour = s.sim_hour;\nconst inventory = global.get(\"inventory\") || {};\nconst devices = inventory[h] || {};\n\n// 1. Dynamic prices (€/kWh) based on the hour (sim_hour)\n//price by default\nlet tariff = 0.15;\nlet period = \"FLAT (0.15 €/kWh)\";\n\n//cheaper prices at nighttime (between 12 and 8 am)\nif (hour >= 0 && hour < 8){ \n    tariff = 0.08;\n    period = \"OFF-PEAK (0.08 €/kWh)\"\n\n//higher prices during peak hours (between 6 and 10 pm)\n} else if (hour >= 18 && hour < 22) {\n    tariff = 0.25;\n    period = \"PEAK (0.25 €/kWh)\"\n}\n\nglobal.set(\"current_tariff\", { rate: tariff, period: period, sim_time: s.sim_time });\n\n\n//2. Cumulative economic cost for each house (1 measurement every 10 sim min = 1/6 h)\n//all houses begin at 0 cost\nconst costs = global.get(\"costs\") || { h1: 0, h2: 0, h3: 0, h4: 0 };\nconst measurementCost = (s.grid_w / 1000.0) * (1.0 / 6.0) * tariff\ncosts[h] = Number(((costs[h] || 0) + measurementCost). toFixed(4));\n//store updated costs in global memory for dashboard\nglobal.set(\"costs\", costs);\n\n//Reading from dashboard\n//reads alarm thresholds configured on dashboard (by default 5500 W and 20% min battery)\nconst thresholds = global.get(\"thresholds\") || {max_grid_w: 5500, min_soc_pct: 20};\n//checks for possible manual orders given through dashboard\nconst overrides = global.get(\"overrides\") || {};\nconst homeOverride = overrides[h] || {};\n\n//RBE (Report By Exception): remember last command sent \n//and only send new ones (not duplicated with last))\nconst lastCmds = flow.get(\"lastCmds\") || {};\nif (!lastCmds[h]) lastCmds[h] = {};\n\nconst outCmds = []; //list of MQTT commands to be sent\nconst actions = []; //readable summary of system decisions\n\n\n//3. Battery mode decision (only for homes equipped with a battery)\nif (s.battery_soc_pct !== null && s.battery_soc_pct !== undefined) {\n    let targetMode = \"auto\";\n    if (homeOverride.battery) {\n        targetMode = homeOverride.battery; //giving priority to a battery mode\n                                        //forced through manual control\n    } else if (hour >= 0 && hour < 8 && s.battery_soc_pct < 80) {\n        targetMode = \"charge_grid\"; //charging the battery from grid is cheaper\n                                    //at night\n    } else if (hour >= 18 && hour < 22 && s.battery_soc_pct > 30) {\n        targetMode = \"discharge\"; //use charge from battery instead of grid during\n                                //peak expensive hours\n    }\n\n    //same RBE pattern, send command only if changed from previous\n    if (lastCmds[h].battery !== targetMode) {\n        lastCmds[h].battery = targetMode;\n        //add to outCmds the MQTT message required by contract:\n        //microgrid/h1/cmd/battery with {\"mode\": \"...\"}\n        outCmds.push({topic: `microgrid/${h}/cmd/battery`, payload: {mode: targetMode}});\n        //add readable note for log\n        actions.push(`Battery -> ${targetMode}`);\n    }\n}\n\n// 4. Automatic load shedding to correct overloads (only for EV and AC)\nconst overload = s.grid_w > thresholds.max_grid_w;\nconst peakLowBatt = (hour >= 18 && hour < 22) && (s.battery_soc_pct !== null && s.battery_soc_pct < thresholds.min_soc_pct + 5);\n\n// Track simulation ticks since last shed to prevent rapid on/off cycling (hunting)\nconst shedCooldown = flow.get(\"shedCooldown\") || {};\nif (!shedCooldown[h]) shedCooldown[h] = { ev: 0, ac: 0 };\nif (shedCooldown[h].ev > 0) shedCooldown[h].ev--;\nif (shedCooldown[h].ac > 0) shedCooldown[h].ac--;\n\n// EV control (only for houses that publish 'ev' telemetry)\nif (devices.ev) {\n    let evState = lastCmds[h].ev || \"on\";\n    if (homeOverride.ev) {\n        evState = homeOverride.ev;\n    } else if (overload || peakLowBatt) {\n        evState = \"off\";\n        shedCooldown[h].ev = 6; // Wait 6 ticks (1 simulated hour) before trying to restore EV\n    } else if (shedCooldown[h].ev === 0 && (s.grid_w + 7000) < thresholds.max_grid_w) {\n        evState = \"on\"; // Only restore EV if adding ~7000 W will NOT cause a new overload\n    }\n\n    if (lastCmds[h].ev !== evState) {\n        lastCmds[h].ev = evState;\n        outCmds.push({topic: `microgrid/${h}/cmd/load/ev`, payload: {state: evState}});\n        actions.push(`EV -> ${evState}`);\n    }\n}\n\n// AC control (only for houses that publish 'ac' telemetry)\nif (devices.ac) {\n    let acState = lastCmds[h].ac || \"on\";\n    if (homeOverride.ac) {\n        acState = homeOverride.ac;\n    } else if (s.grid_w > thresholds.max_grid_w + 1000) {\n        acState = \"off\";\n        shedCooldown[h].ac = 3; // Wait 3 ticks (30 simulated min) before trying to restore AC\n    } else if (shedCooldown[h].ac === 0 && (s.grid_w + 2000) < thresholds.max_grid_w) {\n        acState = \"on\"; // Only restore AC if adding ~2000 W will NOT cause a new overload\n    }\n\n    if (lastCmds[h].ac !== acState) {\n        lastCmds[h].ac = acState;\n        outCmds.push({topic: `microgrid/${h}/cmd/load/ac`, payload: {state: acState}});\n        actions.push(`AC -> ${acState}`);\n    }\n}\nflow.set(\"shedCooldown\", shedCooldown);\nflow.set(\"lastCmds\", lastCmds);\n\n\n//5. Operational alarms (low battery or grid overload)\nlet alarmMsg = null;\nconst lastAlarms = flow.get(\"lastAlarms\") || {}; //to avoid duplicate alarms while a problem is still active\n\n//if the house has a battery and its charge is below the threshold\nif (s.battery_soc_pct !== null && s.battery_soc_pct < thresholds.min_soc_pct) {\n    if (lastAlarms[h] !== \"LOW_BATT\") { //if the alarm hasn't been sent yet\n        lastAlarms[h] = \"LOW_BATT\";\n        alarmMsg = {\n            topic: `microgrid/alarms/${h}`,\n            payload: {\n                home: h,\n                severity: \"WARNING\",\n                type: \"LOW_BATTERY\",\n                message: `${h.toUpperCase()} battery low (${s.battery_soc_pct}%)`\n            }\n        };\n    }\n//if the energy taken from the grid (consumed) is over the threshold\n} else if (s.grid_w > thresholds.max_grid_w + 1500) {\n    if (lastAlarms[h] !== \"OVERLOAD\") { //if the alarm hasn't been sent yet\n        lastAlarms[h] = \"OVERLOAD\";\n        alarmMsg = {\n            topic: `microgrid/alarms/${h}`,\n            payload: {\n                home: h,\n                severity: \"WARNING\",\n                type: \"GRID_OVERLOAD\",\n                message: `${h.toUpperCase()} grid overload (${s.grid_w} W)`\n            }\n        };\n    }\n} else {\n    lastAlarms[h] = null; //the alarm history is cleared \n}\nflow.set(\"lastAlarms\", lastAlarms); //the alarm history is updated\n\nconst decisionMsg = actions.length > 0\n    //action summary for microgrid/decisions/${h}\n    ? { topic: `microgrid/decisions/${h}`, payload: { home: h, sim_time: s.sim_time, actions: actions } }\n    : null;\n\nreturn [outCmds, decisionMsg, alarmMsg];\n//returns 3 exits:\n//  - outCmds: commands for the simulators, such as cmd/battery\n//  - decisionMsg: decision summary (decisions/{h})\n//  - alarmMsg: alerts (alarms/{h})",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 270,
        "y": 220,
