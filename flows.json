    {
        "id": "7c2f8475e5b0a936",
        "type": "function",
        "z": "bf42db88da3ff346",
        "name": "Track Status and LWT",
        "func": "const data = msg.payload;\n\n//if no data for a specific home\nif (!data || !data.home) return null;\n\nconst statuses = global.get(`statuses`) || {};\nconst prev = statuses[data.home];\nstatuses[data.home] = data.status;\n\n//we store the current status of each home in a single \n//map (statuses)\nglobal.set(`statuses`, statuses);\n\n//output 1: updated status map ({house:status})\nconst statusMsg = {payload: statuses};\n\n//output 2: if a house that was previously online\n//has disconnected (LWT), trigger an alarm\nif (data.status === `offline` && prev !== `offline`) {\n    const alarm = {\n        topic: `microgrid/alarms/${data.home}`,\n        payload: {\n            home: data.home,\n            severity: `CRITICAL`,\n            type: `NODE_OFFLINE_LWT`,\n            message: `Home ${data.home.toUpperCase()} disconnected (Last Will)`\n        }\n    };\n    return [statusMsg, alarm];\n}\n\n//output 3: formatted fleet status string for Dashboard text widget\nconst homesMap = global.get(`homes`) || {};\nconst homeIds = Object.keys(homesMap).sort();\nconst statusStr = homeIds.map(id => `${id.toUpperCase()}: ${(statuses[id] || \"online\").toUpperCase()}`).join(\" | \");\nconst fleetTextMsg = { payload: statusStr || \"Waiting...\" };\n\nreturn [statusMsg, null, fleetTextMsg]",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 400,
        "y": 300,
        "wires": [
